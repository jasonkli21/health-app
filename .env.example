# Planned server-only settings. Phase 0 liveness shell does not load these.
# Never copy database credentials or secrets into Expo public environment variables.
APP_ENV=local
DATABASE_URL=postgresql+psycopg://health:health@localhost:5432/health
OBJECT_STORAGE_BACKEND=local
LOCAL_OBJECT_STORAGE_PATH=.data/objects
AUTH_MODE=dev
PERSONAL_AI_BASE_URL=http://localhost:8081
PERSONAL_AI_ENABLED=false
GCP_PROJECT_ID=
GCS_BUCKET=
NEON_DATABASE_URL=
