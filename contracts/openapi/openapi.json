{
  "components": {
    "schemas": {
      "BooleanValue": {
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "boolean",
            "title": "Type",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "type": "boolean"
          }
        },
        "required": ["type", "value"],
        "title": "BooleanValue",
        "type": "object"
      },
      "ConfirmationStatus": {
        "enum": ["unconfirmed", "user_confirmed"],
        "title": "ConfirmationStatus",
        "type": "string"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "field_errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field Errors"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": ["code", "message", "request_id"],
        "title": "ErrorResponse",
        "type": "object"
      },
      "FieldError": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "title": "Field",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": ["field", "message"],
        "title": "FieldError",
        "type": "object"
      },
      "FiniteProfileNumber": {
        "type": "number"
      },
      "MetadataKey": {
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
      },
      "MetadataScalar": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "NumberValue": {
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "number",
            "title": "Type",
            "type": "string"
          },
          "value": {
            "$ref": "#/components/schemas/FiniteProfileNumber"
          }
        },
        "required": ["type", "value"],
        "title": "NumberValue",
        "type": "object"
      },
      "ProfileCategory": {
        "enum": ["background", "constraints", "preferences"],
        "title": "ProfileCategory",
        "type": "string"
      },
      "ProfileCreateRequest": {
        "additionalProperties": false,
        "properties": {
          "ai_use_allowed": {
            "default": false,
            "title": "Ai Use Allowed",
            "type": "boolean"
          },
          "cross_domain_use_allowed": {
            "default": false,
            "title": "Cross Domain Use Allowed",
            "type": "boolean"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "metadata": {
            "$ref": "#/components/schemas/ProfileMetadata"
          },
          "notes": {
            "anyOf": [
              {
                "maxLength": 4000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "profile": {
            "$ref": "#/components/schemas/ProfilePayloadV1"
          },
          "valid_from": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UTCInstant"
              },
              {
                "type": "null"
              }
            ]
          },
          "valid_to": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UTCInstant"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["id", "profile"],
        "title": "ProfileCreateRequest",
        "type": "object"
      },
      "ProfileHistoryEntry": {
        "additionalProperties": false,
        "properties": {
          "actor_kind": {
            "const": "user",
            "title": "Actor Kind",
            "type": "string"
          },
          "reason": {
            "enum": ["create", "update", "archive"],
            "title": "Reason",
            "type": "string"
          },
          "recorded_at": {
            "format": "date-time",
            "title": "Recorded At",
            "type": "string"
          },
          "revision": {
            "minimum": 1.0,
            "title": "Revision",
            "type": "integer"
          },
          "snapshot": {
            "$ref": "#/components/schemas/ProfileItemResponse"
          }
        },
        "required": [
          "revision",
          "recorded_at",
          "actor_kind",
          "reason",
          "snapshot"
        ],
        "title": "ProfileHistoryEntry",
        "type": "object"
      },
      "ProfileHistoryResponse": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ProfileHistoryEntry"
            },
            "title": "Items",
            "type": "array"
          },
          "next_after_revision": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next After Revision"
          }
        },
        "required": ["items", "next_after_revision"],
        "title": "ProfileHistoryResponse",
        "type": "object"
      },
      "ProfileItemResponse": {
        "additionalProperties": false,
        "properties": {
          "confirmation_status": {
            "$ref": "#/components/schemas/ConfirmationStatus"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "domain": {
            "const": "profile",
            "title": "Domain",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "metadata": {
            "$ref": "#/components/schemas/ProfileMetadata"
          },
          "notes": {
            "anyOf": [
              {
                "maxLength": 4000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "object_type": {
            "const": "profile_item",
            "title": "Object Type",
            "type": "string"
          },
          "permissions": {
            "$ref": "#/components/schemas/ProfilePermissions"
          },
          "profile": {
            "$ref": "#/components/schemas/ProfilePayloadV1"
          },
          "recorded_at": {
            "format": "date-time",
            "title": "Recorded At",
            "type": "string"
          },
          "revision": {
            "minimum": 1.0,
            "title": "Revision",
            "type": "integer"
          },
          "schema_version": {
            "const": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "source": {
            "$ref": "#/components/schemas/ProfileSource"
          },
          "status": {
            "enum": ["active", "archived"],
            "title": "Status",
            "type": "string"
          },
          "title": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "valid_from": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Valid From"
          },
          "valid_to": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Valid To"
          }
        },
        "required": [
          "id",
          "object_type",
          "domain",
          "status",
          "title",
          "valid_from",
          "valid_to",
          "recorded_at",
          "created_at",
          "updated_at",
          "source",
          "confirmation_status",
          "schema_version",
          "revision",
          "notes",
          "metadata",
          "permissions",
          "profile"
        ],
        "title": "ProfileItemResponse",
        "type": "object"
      },
      "ProfileKind": {
        "enum": ["fact", "constraint", "preference"],
        "title": "ProfileKind",
        "type": "string"
      },
      "ProfileListResponse": {
        "additionalProperties": false,
        "properties": {
          "as_of": {
            "format": "date-time",
            "title": "As Of",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ProfileItemResponse"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": ["items", "as_of", "next_cursor"],
        "title": "ProfileListResponse",
        "type": "object"
      },
      "ProfileMetadata": {
        "additionalProperties": {
          "$ref": "#/components/schemas/MetadataScalar"
        },
        "description": "Small display-safe extension map; never an unvalidated payload escape hatch.",
        "maxProperties": 30,
        "propertyNames": {
          "$ref": "#/components/schemas/MetadataKey"
        },
        "title": "ProfileMetadata",
        "type": "object"
      },
      "ProfilePatchRequest": {
        "additionalProperties": false,
        "properties": {
          "ai_use_allowed": {
            "title": "Ai Use Allowed",
            "type": "boolean"
          },
          "cross_domain_use_allowed": {
            "title": "Cross Domain Use Allowed",
            "type": "boolean"
          },
          "expected_revision": {
            "minimum": 1.0,
            "title": "Expected Revision",
            "type": "integer"
          },
          "metadata": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProfileMetadata"
              },
              {
                "type": "null"
              }
            ]
          },
          "notes": {
            "anyOf": [
              {
                "maxLength": 4000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "profile": {
            "$ref": "#/components/schemas/ProfilePayloadV1",
            "description": "Omit to keep the current payload; explicit null is invalid."
          },
          "valid_from": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Valid From"
          },
          "valid_to": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Valid To"
          }
        },
        "required": ["expected_revision"],
        "title": "ProfilePatchRequest",
        "type": "object"
      },
      "ProfilePayloadV1": {
        "additionalProperties": false,
        "properties": {
          "category": {
            "$ref": "#/components/schemas/ProfileCategory"
          },
          "key": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "title": "Key",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/ProfileKind"
          },
          "label": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Label",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProfileValue"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["kind", "category", "key", "label", "value"],
        "title": "ProfilePayloadV1",
        "type": "object"
      },
      "ProfilePermissions": {
        "additionalProperties": false,
        "properties": {
          "ai_use_allowed": {
            "title": "Ai Use Allowed",
            "type": "boolean"
          },
          "cross_domain_use_allowed": {
            "title": "Cross Domain Use Allowed",
            "type": "boolean"
          }
        },
        "required": ["ai_use_allowed", "cross_domain_use_allowed"],
        "title": "ProfilePermissions",
        "type": "object"
      },
      "ProfileSource": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "manual",
              "device",
              "document",
              "provider",
              "ai",
              "system"
            ],
            "title": "Kind",
            "type": "string"
          },
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": ["id", "kind", "name"],
        "title": "ProfileSource",
        "type": "object"
      },
      "ProfileUnit": {
        "enum": [
          "kg",
          "g",
          "lb",
          "mg",
          "mcg",
          "ml",
          "l",
          "cm",
          "m",
          "in",
          "mmHg",
          "bpm",
          "%",
          "day",
          "week",
          "year",
          "dose"
        ],
        "title": "ProfileUnit",
        "type": "string"
      },
      "ProfileValue": {
        "discriminator": {
          "mapping": {
            "boolean": "#/components/schemas/BooleanValue",
            "number": "#/components/schemas/NumberValue",
            "quantity": "#/components/schemas/QuantityValue",
            "text": "#/components/schemas/TextValue",
            "text_list": "#/components/schemas/TextListValue"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/TextValue"
          },
          {
            "$ref": "#/components/schemas/BooleanValue"
          },
          {
            "$ref": "#/components/schemas/NumberValue"
          },
          {
            "$ref": "#/components/schemas/QuantityValue"
          },
          {
            "$ref": "#/components/schemas/TextListValue"
          }
        ]
      },
      "QuantityValue": {
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "quantity",
            "title": "Type",
            "type": "string"
          },
          "unit": {
            "$ref": "#/components/schemas/ProfileUnit"
          },
          "value": {
            "$ref": "#/components/schemas/FiniteProfileNumber"
          }
        },
        "required": ["type", "value", "unit"],
        "title": "QuantityValue",
        "type": "object"
      },
      "TextListValue": {
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "text_list",
            "title": "Type",
            "type": "string"
          },
          "value": {
            "items": {
              "maxLength": 200,
              "type": "string"
            },
            "maxItems": 50,
            "title": "Value",
            "type": "array"
          }
        },
        "required": ["type", "value"],
        "title": "TextListValue",
        "type": "object"
      },
      "TextValue": {
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "text",
            "title": "Type",
            "type": "string"
          },
          "value": {
            "maxLength": 2000,
            "title": "Value",
            "type": "string"
          }
        },
        "required": ["type", "value"],
        "title": "TextValue",
        "type": "object"
      },
      "UTCInstant": {
        "format": "date-time",
        "type": "string"
      }
    }
  },
  "info": {
    "description": "Owner-scoped Profile v1 API for private local development. The server principal is configured outside request data. Request bodies are limited to 65,536 bytes.",
    "title": "Personal Health API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "description": "Return process liveness without exposing health-domain data or DB state.",
        "operationId": "healthcheck",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Healthcheck",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthcheck",
        "tags": ["system"]
      }
    },
    "/profile": {
      "get": {
        "operationId": "listProfileItems",
        "parameters": [
          {
            "in": "query",
            "name": "as_of",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "As Of"
            }
          },
          {
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/ProfileCategory"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Category"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 2048,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Local principal is unavailable."
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request body exceeds the 65,536 byte limit."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request validation failed."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Profile storage is unavailable."
          }
        },
        "summary": "List Profiles",
        "tags": ["profile"]
      },
      "post": {
        "operationId": "createProfileItem",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileItemResponse"
                }
              }
            },
            "description": "Idempotent create retry."
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileItemResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Local principal is unavailable."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Revision or ID conflict."
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request body exceeds the 65,536 byte limit."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request validation failed."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Profile storage is unavailable."
          }
        },
        "summary": "Create Profile",
        "tags": ["profile"]
      }
    },
    "/profile/{item_id}": {
      "delete": {
        "operationId": "archiveProfileItem",
        "parameters": [
          {
            "in": "path",
            "name": "item_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Item Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "expected_revision",
            "required": true,
            "schema": {
              "minimum": 1,
              "title": "Expected Revision",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileItemResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Local principal is unavailable."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Profile item was not found."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Revision or ID conflict."
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request body exceeds the 65,536 byte limit."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request validation failed."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Profile storage is unavailable."
          }
        },
        "summary": "Delete Profile",
        "tags": ["profile"]
      },
      "get": {
        "operationId": "getProfileItem",
        "parameters": [
          {
            "in": "path",
            "name": "item_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Item Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileItemResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
